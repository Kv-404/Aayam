{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "client/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://timetable.kv404.workers.dev/api/:path*"
    },
    {
      "source": "/mcp",
      "destination": "https://timetable.kv404.workers.dev/mcp"
    },
    {
      "source": "/mcp/:path*",
      "destination": "https://timetable.kv404.workers.dev/mcp/:path*"
    },
    {
      "source": "/oauth/:path*",
      "destination": "https://timetable.kv404.workers.dev/oauth/:path*"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "https://timetable.kv404.workers.dev/.well-known/:path*"
    },
    {
      "source": "/((?!api/|assets/|mcp$|mcp/|oauth/|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
