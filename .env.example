# Local settings for the sync job (npm run sync / npm run dev). Copy to .env. Never commit .env.
# The Worker does not read this file: local Worker secrets go in .dev.vars, production ones via `wrangler secret put`.

# Sheets. Leave unset to use the production ids in server/src/config.ts. A full URL or a bare id both work.
# An admin can also repoint a batch at /admin; that link is stored in D1 and wins over these.
# SPREADSHEET_BTECH_2026_30=
# SPREADSHEET_BTECH_2025_29=
# SPREADSHEET_BTECH_2024_28=
# SPREADSHEET_BTECH_2023_27=
# SPREADSHEET_MCA_2026_28=

COLLEGE_NAME=ITM Skills University
TIMEZONE=Asia/Kolkata
# The sheet writes dates as DD/MM/YYYY.
DATE_ORDER=DMY
# Inferred edits stay highlighted this long. Explicit OFF/cancelled stays until the sheet changes.
HIGHLIGHT_HOURS=72

# Only to run the job against the real D1 from your machine (CI sets these from repo secrets).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# D1_DATABASE_ID=
