# Public college timetable spreadsheets.
# You can paste either the full Google Sheets URL or just the spreadsheet ID.
# The admin can manually change the link/ID for any or all cohorts:
SPREADSHEET_BTECH_2026_30=your_google_sheet_id_or_url
SPREADSHEET_BTECH_2025_29=your_google_sheet_id_or_url
SPREADSHEET_BTECH_2024_28=your_google_sheet_id_or_url
SPREADSHEET_BTECH_2023_27=your_google_sheet_id_or_url
SPREADSHEET_MCA_2026_28=your_google_sheet_id_or_url

# Alternatively, specify a comma-separated list of links or IDs:
# SPREADSHEET_IDS=https://docs.google.com/spreadsheets/d/.../edit,https://...

# Or for a single-sheet deployment:
# SPREADSHEET_ID=your_google_sheet_id_or_url
SPREADSHEET_TITLE=Weekly Cohort Timetable

COLLEGE_NAME=College Name
SCHOOL_NAME=School of Technology
COURSE_NAME=BTech

# Asia/Kolkata or your local timezone
TIMEZONE=Asia/Kolkata
# The sheet writes dates as DD/MM/YYYY.
DATE_ORDER=DMY

PORT=8787
# How often the server re-reads the sheet. 45 seconds is within the requested 30–60s range.
SYNC_INTERVAL_SECONDS=45
# Inferred edits stay highlighted for this long, then return to the normal style.
# Explicit OFF / CANCELLED stays red until the sheet itself changes.
HIGHLIGHT_HOURS=72

DATABASE_PATH=./data/timetable.sqlite

# Neon PostgreSQL Database (for Faculty Directory & Authentication)
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Google OAuth & Authentication
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
ALLOWED_EMAIL_DOMAINS=example.edu,example.ac.in
ALLOWED_EMAIL_DOMAIN=example.edu,example.ac.in

# Set by the Vercel Blob store. Keeps the timetable and its change log across
# cold starts, so a lecture removed from the sheet stays on the grid as cancelled.
# BLOB_READ_WRITE_TOKEN=

# Set this if the Vite app is hosted separately and calls the API on another origin.
# CLIENT_ORIGIN=https://timetable.example.com
# VITE_API_URL=https://api.example.com
